{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wx-doc-format.invalid/contracts/source-facts-1.0.schema.json",
  "title": "WX Modular SourceFacts 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["facts_schema_version", "source", "parser", "units", "containers", "children", "evidence", "resources", "diagnostics", "extensions"],
  "properties": {
    "facts_schema_version": {"const": "1.0"},
    "source": {
      "type": "object",
      "required": ["source_id", "source_type", "content_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["markdown", "docx", "text", "unknown"]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "encoding": {"type": "string"}
      }
    },
    "parser": {
      "type": "object",
      "required": ["id", "version", "dialect", "config_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "dialect": {"type": "string", "minLength": 1},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "units": {"type": "object", "additionalProperties": {"$ref": "#/$defs/unit"}},
    "containers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/container"}},
    "children": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": {"type": "object"}},
    "resources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/resource"}},
    "diagnostics": {"type": "array", "items": {"type": "object", "required": ["code", "severity", "message"]}},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceRef": {
      "type": "object",
      "required": ["source_id", "part", "content_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "part": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "span": {"type": "object", "required": ["start", "end", "unit"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "unit": {"const": "unicode_code_point"}}},
        "node_path": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string"}, {"type": "integer"}]}}
      },
      "oneOf": [{"required": ["span"]}, {"required": ["node_path"]}]
    },
    "unit": {
      "type": "object",
      "required": ["kind", "source_ref"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/sourceRef"}, "inline_content": {"type": "array"}}
    },
    "container": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "minLength": 1}}},
    "resource": {
      "type": "object",
      "required": ["kind", "source_ref", "content_sha256"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/sourceRef"}, "content_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
