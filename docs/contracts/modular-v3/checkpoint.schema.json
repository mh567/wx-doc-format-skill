{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wx-doc-format.invalid/contracts/checkpoint-2.0.schema.json",
  "title": "WX Modular Checkpoint 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["checkpoint_schema_version", "run_id", "status", "resume_stage", "source_facts", "decision_ledger", "source_ast", "normalized_ast", "content_overlay", "presentation_override", "target_map", "resource_summary", "contracts", "modules", "requests", "responses", "applied_transactions", "transaction_content_digests", "budget", "round", "candidate_baseline_id"],
  "properties": {
    "checkpoint_schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["created", "running", "waiting_external", "completed", "completed_with_warnings", "failed", "cancelled"]},
    "resume_stage": {"type": ["string", "null"]},
    "profile": {"type": "string", "minLength": 1},
    "list_policy": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests_path", "responses_path"],
      "properties": {
        "requests_path": {"type": "string", "minLength": 1},
        "responses_path": {"type": "string", "minLength": 1}
      }
    },
    "source_facts": {"type": "object"},
    "decision_ledger": {"type": "object"},
    "source_ast": {"type": "object"},
    "normalized_ast": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["schema_version", "revision", "document"],
          "properties": {"schema_version": {"const": "2.0"}}
        },
        {
          "type": "object",
          "required": ["schema_version", "source_revision", "source_ast", "overlay", "presentation_override", "presentation", "generated_nodes", "template_preflight", "diagnostics", "semantic_digest", "presentation_digest", "context"],
          "properties": {
            "schema_version": {"const": "1.0"},
            "source_revision": {"type": "integer", "minimum": 0},
            "source_ast": {"type": "object"},
            "overlay": {"type": "object"},
            "presentation_override": {"type": "object"},
            "presentation": {"type": "object"},
            "generated_nodes": {"type": "array"},
            "template_preflight": {"type": "object"},
            "diagnostics": {"type": "array"},
            "semantic_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "presentation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "context": {"type": "object"}
          }
        }
      ]
    },
    "content_overlay": {"type": "array"},
    "presentation_override": {"type": "array"},
    "target_map": {"type": "object", "required": ["revision", "entries", "view_sha256"]},
    "resource_summary": {"type": "object", "required": ["resources", "source_sha256"]},
    "contracts": {"type": "object", "required": ["source_facts", "ast", "patch", "checkpoint"]},
    "modules": {"type": "array"},
    "requests": {"type": "array"},
    "responses": {"type": "array"},
    "applied_transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transaction_id", "content_sha256"],
        "properties": {
          "transaction_id": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "transaction_content_digests": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "budget": {"type": "object", "required": ["limit", "consumed", "waiting_seconds"]},
    "round": {"type": "integer", "minimum": 0},
    "candidate_baseline_id": {"type": "string", "minLength": 1},
    "semantic_digest": {"type": "string", "minLength": 1},
    "presentation_digest": {"type": "string", "minLength": 1}
  }
}
